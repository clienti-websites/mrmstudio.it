# Consegna delle richieste dal modulo contatti
# (app/api/contatti/route.ts, lib/email.ts).
#
# Le richieste vengono spedite via SMTP alla casella dello studio. Se una
# sola di queste variabili manca, o se la consegna fallisce, la route non
# finge: risponde con un errore e il modulo mostra a chi ha scritto i
# numeri di telefono e l'email delle due sedi, invece di una conferma
# falsa.

# Server di posta in uscita. Su Aruba: smtps.aruba.it
SMTP_HOST=smtps.aruba.it

# 465 parla cifrato dal primo byte. Se la 465 risulta chiusa in uscita,
# si passa alla 587, che negozia la cifratura dopo il saluto.
SMTP_PORT=465

# Casella e password del servizio di posta.
SMTP_USER=
SMTP_PASS=

# Casella che riceve le richieste del modulo.
CONTACT_TO_EMAIL=

# Mittente delle email inviate dal sito. Deve appartenere al dominio
# autenticato, altrimenti i controlli SPF e DMARC fanno finire tutto
# nella posta indesiderata. Non è mai l'indirizzo del visitatore, che
# viene messo in "Rispondi a".
CONTACT_FROM_EMAIL=

# Cartella in cui il sito mette una copia di sicurezza delle richieste
# PRIMA di tentare l'invio. Se la consegna riesce, la copia viene
# cancellata subito: nella cartella restano soltanto le richieste che non
# sono arrivate, ed e' quella la lista da controllare.
#
# Va messa FUORI dalla cartella del progetto, altrimenti un rilascio la
# cancella. Viene creata se non esiste, e l'utente che fa girare Node deve
# potervi scrivere.
#
# Se questa variabile manca, il sito funziona lo stesso ma non conserva
# nulla: in quel caso, se la consegna fallisce, a chi scrive NON viene detto
# che la richiesta e' arrivata, perche' non sarebbe vero.
CONTACT_STORE_DIR=/var/lib/mrmstudio/richieste
