# Contact form email delivery (app/api/contatti/route.ts, lib/email.ts).
#
# Both variables are required for /api/contatti to actually deliver
# enquiries via Resend's REST API (https://resend.com). If either is
# missing, or the send fails, the route fails closed: it returns a 5xx
# and the form shows the enquirer an honest error with the studio's real
# phone numbers and email instead of a false "sent" confirmation.

# Resend API key (from https://resend.com/api-keys).
RESEND_API_KEY=

# Mailbox that should receive contact-form enquiries.
CONTACT_TO_EMAIL=
